# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Optional: public address of THIS website, used inside QR codes.
# Leave empty to use the address the admin is currently browsing from.
# Set it when parents will scan from phones, e.g. http://192.168.1.20:5173 or https://yourwebsite.com
VITE_PUBLIC_URL=
